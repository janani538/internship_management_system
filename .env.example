# ==============================================================
# AI-Powered Internship Management & Project Review System
# Environment Configuration Template
# ==============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file containing real secrets to Git.

# --- AI Service Configuration (Optional, fallback heuristic engine works out-of-the-box) ---
# Google Gemini API Key (Recommended for task explanation & repository analysis)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Alternative: GOOGLE_API_KEY
GOOGLE_API_KEY=

# OpenAI API Key (Alternative if you prefer OpenAI GPT-4o / GPT-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Preferred AI Model provider: "gemini", "openai", or "auto"
AI_PROVIDER=auto

# --- GitHub API Configuration (Optional) ---
# GitHub Personal Access Token (Increases rate limit from 60 req/hr to 5,000 req/hr)
# Generate at: https://github.com/settings/tokens (No special permissions needed for public repos)
GITHUB_TOKEN=

# --- SMTP Email Configuration ---
# Configure your SMTP server for sending review schedules & task notifications.
# NOTE: By default, EMAIL_SIMULATION_MODE=True generates previews without sending real emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Internship Review System"

# Safety toggle: set to "False" ONLY when you explicitly wish to send real emails!
EMAIL_SIMULATION_MODE=True

# --- Application & Database Settings ---
DATABASE_PATH=internship_system.db
APP_ENV=development
